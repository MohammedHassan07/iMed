// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model medicine {
  id               Int            @id @default(autoincrement())
  saltName         String         @unique
  brandName        String
  manufacturer     String
  packageQuantity  Int
  productForm      String
  minQuantityAlert Int
  storageCondition String
  boxNumber        Int?
  description      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  purchaseItems    PurchaseItem[]
}

model Purchase {
  id           Int      @id @default(autoincrement())
  supplierId   Int
  purchaseDate DateTime
  notes        String?
  discountType String   @default("percentage")
  discount     Float    @default(0)
  subTotal     Float    @default(0)
  // totalTax     Float    @default(0)
  netTotal     Float    @default(0)
  tax          Float    @default(0)
  total        Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchasedItems PurchaseItem[]
}

model PurchaseItem {
  id         Int @id @default(autoincrement())
  purchaseId Int
  medicineId Int

  batchNumber             String
  expiryDate              DateTime
  purchasePrice           Float
  sellingPrice            Float
  sellingPricePerMedicine Float
  quantity                Int
  profit                  Float
  tax                     Float
  total                   Float
  totalMedicines          Float
  remainingMedicines      Float
  scheme                  Float
  isSold                  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
}

model Supplier {
  id            Int    @id @default(autoincrement())
  companyName   String
  contactPerson String
  contact       String
  email         String @unique
  address       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tax {
  id         Int    @id @default(autoincrement())
  taxName    String
  percentage String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sales {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId      Int?
  patientName    String?
  patientContact String?
  patientAddress String?

  subTotal       Float  @default(0)
  netTotal       Float  @default(0)
  discount       Float  @default(0)
  discountType   String @default("percentage")
  deliveryCharge Float  @default(0)

  items SalesItem[]
}

model SalesItem {
  id             Int    @id @default(autoincrement())
  saleId         Int
  purchaseItemId Int?
  itemId         Int
  batchNumber    String
  quantity       Int
  sellingPrice   Float
  totalAmount    Float

  sale Sales @relation(fields: [saleId], references: [id], onDelete: Cascade)
}
