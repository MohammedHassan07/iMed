generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model medicine {
  id                  Int                     @id @default(autoincrement())
  itemCode            String
  saltName            String                  @unique
  brandName           String
  manufacturer        String
  packageQuantity     Int
  productForm         String
  minQuantityAlert    Int
  storageCondition    String
  boxNumber           Int?
  description         String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  purchaseItems       PurchaseItem[]
  salesItems          SalesItem[]
  returnPurchaseItems ReturnedPurchasedItem[]
}

model Purchase {
  id                   Int                     @id @default(autoincrement())
  supplierId           Int
  purchaseDate         DateTime?
  purchaseNumber       String
  purchaseType         String                  @default("PURCHASE")
  notes                String?
  discountType         String?                 @default("percentage")
  discount             Float?                  @default(0)
  subTotal             Float                   @default(0)
  netTotal             Float                   @default(0)
  tax                  Float?                  @default(0)
  total                Float                   @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  purchasedItems       PurchaseItem[]
  returnPurchasedItems ReturnedPurchasedItem[]
  paymentId            Int
  payment              payment                 @relation("PaymentToPurchase", fields: [paymentId], references: [id])
}

model PurchaseItem {
  id                      Int      @id @default(autoincrement())
  purchaseId              Int
  medicineId              Int
  batchNumber             String
  expiryDate              DateTime
  purchasePrice           Float
  purchaseDate            DateTime
  sellingPrice            Float
  sellingPricePerMedicine Float
  quantity                Int
  packageQuantity         Float
  profit                  Float
  tax                     Float
  total                   Float
  totalMedicines          Float
  remainingMedicines      Float
  scheme                  Float
  isSold                  Boolean  @default(false)
  isExpired               Boolean  @default(false)
  nearToExpire            Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  purchase                Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine                medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
}

model ReturnedPurchasedItem {
  id               Int      @id @default(autoincrement())
  purchaseId       Int
  parentPurchaseId Int
  // parentPurchase   Purchase @relation(fields: [parentPurchaseId], references: [id], onDelete: Cascade)
  medicineId       Int
  batchNumber      String
  expiryDate       DateTime
  purchasePrice    Float
  reason           String
  createdAt        DateTime @default(now())
  returnDate       DateTime
  purchaseDate     DateTime

  sellingPrice            Float
  sellingPricePerMedicine Float
  quantity                Int
  packageQuantity         Float

  totalMedicines Float

  updatedAt DateTime @updatedAt
  purchase  Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine  medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
}

model Supplier {
  id            Int      @id @default(autoincrement())
  companyName   String
  contactPerson String
  contact       String
  email         String   @unique
  address       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Tax {
  id         Int      @id @default(autoincrement())
  taxName    String
  percentage String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum SalesType {
  SALE
  REFUND
}

model Sales {
  id             Int         @id @default(autoincrement())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  salesNumber    String
  patientId      Int?
  patientName    String?
  patientContact String?
  patientAddress String?
  subTotal       Float       @default(0)
  netTotal       Float       @default(0)
  discount       Float       @default(0)
  discountType   String      @default("percentage")
  deliveryCharge Float       @default(0)
  salesType      SalesType
  items          SalesItem[]
  paymentId      Int
  payment        payment     @relation("PaymentToSales", fields: [paymentId], references: [id])
}

model SalesItem {
  id             Int      @id @default(autoincrement())
  saleId         Int
  purchaseItemId Int?
  itemId         Int
  batchNumber    String
  quantity       Int
  sellingPrice   Float
  totalAmount    Float
  sale           Sales    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items          medicine @relation(fields: [itemId], references: [id])
}

enum paymentType {
  SALE
  REFUND
  PURCHASE
  RETURN
}

model payment {
  id            Int         @id @default(autoincrement())
  paymentType   paymentType
  paymentNumber String
  createdAt     DateTime    @default(now())
  amount        Float

  sales     Sales[]    @relation("PaymentToSales")
  purchases Purchase[] @relation("PaymentToPurchase")
}

model Company {
  id          Int      @id @default(autoincrement())
  companyName String
  mfgCode     String   @unique
  // contact       String
  // email         String   @unique
  // address       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
